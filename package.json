{
  "name": "@bzenky/branch-care",
  "version": "1.0.0",
  "author": "bzenky",
  "publishConfig": {
    "access": "public"
  },
  "description": "Safely inspect and clean merged local Git branches",
  "keywords": [
    "git",
    "branch",
    "cleanup",
    "cli",
    "maintenance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzenky/branch-care.git"
  },
  "homepage": "https://github.com/bzenky/branch-care#readme",
  "bugs": {
    "url": "https://github.com/bzenky/branch-care/issues"
  },
  "type": "module",
  "bin": {
    "branch-care": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "!dist/src/undo-history.d.ts",
    "!dist/src/undo-history.d.ts.map",
    "!dist/src/undo-history.js.map",
    "!dist/src/commands/undo.d.ts",
    "!dist/src/commands/undo.d.ts.map",
    "!dist/src/commands/undo.js.map",
    "!dist/src/analysis.js.map",
    "!dist/src/types.js.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=2 dist/test/*.test.js",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "release:package": "node scripts/release-create.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "prepublishOnly": "npm test && npm run package:smoke"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@types/node": "^26.6.2",
    "typescript": "^5.8.2"
  }
}
